# Used by the Next.js server to reach the Spring Boot API.
API_BASE_URL=http://localhost:8080

# Local PostgreSQL container settings used by compose.yaml.
POSTGRES_DB=career_os
POSTGRES_USER=career_os
POSTGRES_PASSWORD=career_os_local
POSTGRES_PORT=5432

# Optional overrides read by Spring Boot when exported into the API process.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/career_os
SPRING_DATASOURCE_USERNAME=career_os
SPRING_DATASOURCE_PASSWORD=career_os_local

# Google OAuth web client. Keep real values only in an ignored local file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the API sends the browser after Google sign-in.
FRONTEND_URL=http://localhost:3000
